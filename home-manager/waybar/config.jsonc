// NOTE: The <span></span> markups are in [pango markup](https://docs.gtk.org/Pango/pango_markup.html)
{
  "layer": "top",
  "position": "left",
  "margin-left": 16,
  "margin-right": 0,
  // "position": "right",
  // "margin-left": 0,
  // "margin-right": 16,
  "width": 40,
  "margin-top": 16,
  "margin-bottom": 16,
  "modules-left": [
    "custom/nix-logo",
    "niri/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "battery",
    "pulseaudio"
  ],
  // TODO: Consider using the image module instead
  "custom/nix-logo": {
    "format": " ",
    "tooltip": false
  },
  "niri/workspaces": {
    "format": "{icon}",
    // NOTE: Workspace 1 is always empty due to the `empty-workspace-above-first` setting in niri,
    // so we refer to it as the "zeroth" workspace
    "format-icons": {
      // "1": "〇",
      // "2": "一",
      // "3": "二",
      // "4": "三",
      // "5": "四",
      // "6": "五",
      // "7": "六",
      // "8": "七",
      // "9": "八",
      // "10": "九",
      // "11": "十"
      "1": "零",
      "2": "壹",
      "3": "貳",
      "4": "參",
      "5": "肆",
      "6": "伍",
      "7": "陸",
      "8": "柒",
      "9": "捌",
      "10": "玖",
      "11": "拾"
    }
  },
  "clock": {
    "justify": "center",
    "locale": "ja_JP.utf8",
    // "format": "{:%d\n<small>%a</small>\n\n<span color='#f0cabf'>%H\n%M</span>}",
    "format": "{:L%d\n<span size='9pt' font='UDEV Gothic'>%a</span>\n\n<span color='#f0cabf'>%H\n%M</span>}",
    // "tooltip-format": "<small>{calendar}</small>",
    "tooltip-format": "<span size='9pt' font='UDEV Gothic'>{calendar}</span>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#f0cabf'><b>{}</b></span>",
        "days": "<span color='#e0def4'><b>{}</b></span>",
        "weeks": "<span color='#c4a7e7'><b>W{}</b></span>",
        "weekdays": "<span color='#9ccfd8'><b>{}</b></span>",
        "today": "<span background='#f0cabf' color='#000000'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "battery": {
    "justify": "center",
    "format": "<span size='80%'>{icon}</span>\n{capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "bat": "BAT1",
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15
    }
  },
  "pulseaudio": {
    "justify": "center",
    "format": "<span size='80%'>{icon}</span>\n{volume}%",
    "format-bluetooth": "<span size='80%'>{icon}</span>\n{volume}%",
    "format-muted": "<span size='80%'></span>\n—",
    "format-icons": {
      "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
      "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "phone-muted": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        ""
      ]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol"
  }
}